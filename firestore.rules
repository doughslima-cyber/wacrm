rules_version = '2';

// Firestore only carries realtime signals (docs/firebase-migration.md
// §3.4, phase 4): which row of which table changed, never its content.
// The relay (infra/relay-realtime) writes them with the Admin SDK,
// which these rules don't apply to. Browsers may read the signals of
// the accounts in their `accountIds` claim (src/lib/auth/claims.ts)
// and nothing else; nobody writes from a client.
service cloud.firestore {
  match /databases/{database}/documents {
    match /signals/{accountId}/changes/{changeId} {
      allow read: if request.auth != null
        && request.auth.token.accountIds is list
        && accountId in request.auth.token.accountIds;
    }
  }
}
